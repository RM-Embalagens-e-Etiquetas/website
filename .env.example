# Local development (SQLite + pasta media/)
PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URI=file:./payload.sqlite
SEED_ADMIN_EMAIL=admin@rmembalagens.local
SEED_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel production — Settings → Environment Variables (Production + Preview)
# PAYLOAD_SECRET=...
# POSTGRES_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# NEXT_PUBLIC_SERVER_URL=https://rm-embalagens.vercel.app

# Popular o CMS de produção (GitHub → Actions → Seed production → Run workflow)
# Secrets no repositório: PAYLOAD_SECRET, POSTGRES_URL, BLOB_READ_WRITE_TOKEN
# Opcional: SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD
