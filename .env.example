# Local development (SQLite + pasta media/)
PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URI=file:./payload.sqlite
SEED_ADMIN_EMAIL=admin@rmembalagens.local
SEED_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel production — adicione no painel do projeto (Settings → Environment Variables)
# PAYLOAD_SECRET=string-longa-aleatoria-min-32-chars
# POSTGRES_URL=postgres://... (Neon / Vercel Postgres — criado ao adicionar Storage → Postgres)
# BLOB_READ_WRITE_TOKEN=vercel_blob_... (criado ao adicionar Storage → Blob)
# NEXT_PUBLIC_SERVER_URL=https://rm-embalagens.vercel.app
